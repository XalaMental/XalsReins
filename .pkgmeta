package-as: XalsReins

# Files/folders in the repo that shouldn't end up inside the distributed addon
# zip - players don't need CI config, git's own housekeeping files, or the
# screenshots used on the CurseForge/GitHub page.
ignore:
  - .github
  - .gitignore
  - images
  - research
  - ArtSource

# Use our hand-maintained, styled changelog as the release changelog on
# CurseForge instead of the packager's auto-generated commit list.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
